{
  "name": "dsh-usage-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web 侧边栏当日 Token 用量按钮：自建账本记录每次模型调用的 token，点击弹窗按时间范围下钻（日 → 小时 → 模型），并按模型/供应商拆分。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "scan-report": "node scripts/scan-report.mjs",
    "usage-report": "node scripts/usage-report.mjs",
    "verify-day": "node scripts/verify-day.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT"
}
